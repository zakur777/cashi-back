meta {
  name: Get Missing Transaction 404
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/transactions/{{missingTransactionId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

script:post-response {
  test("returns 404 for a missing transaction", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
