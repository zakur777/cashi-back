meta {
  name: 2-Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "ada@example.com",
    "password": "password123"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body?.token) {
    bru.setVar("authToken", body.token);
  }
}
