meta {
  name: 4-Create Category
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "name": "Food Demo",
    "type": "expense",
    "color": "#EDF7BD"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body?.id) {
    bru.setVar("categoryId", String(body.id));
  }
}
